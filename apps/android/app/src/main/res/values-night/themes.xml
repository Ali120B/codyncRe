<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Codync" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/codync_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/codync_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
